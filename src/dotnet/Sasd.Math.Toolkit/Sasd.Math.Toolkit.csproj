<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Sasd.Math.Toolkit</AssemblyName>
    <RootNamespace>Sasd.Numerics</RootNamespace>

    <PackageId>Sasd.Math.Toolkit</PackageId>
    <Title>SASD Math Toolkit</Title>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Description>Reusable numerical methods and applied mathematics foundation for SASD projects, including modern dense and sparse linear algebra, calculus, ODE solvers, approximation and transforms.</Description>
    <Authors>Robin Goerlach; SASD-GmbH</Authors>
    <Copyright>Copyright (c) 2026 Robin Goerlach (SASD-GmbH)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/Robin-Goerlach/SASD-Math-Toolkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Robin-Goerlach/SASD-Math-Toolkit.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>numerics;mathematics;linear-algebra;sparse;fft;ode;scientific-computing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Legacy public APIs are still being brought to complete XML-comment coverage. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE-README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
